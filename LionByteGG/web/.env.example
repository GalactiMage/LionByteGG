# LionByteGG Web Dashboard Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ===========================================
# FLASK CONFIGURATION
# ===========================================

# Set to 'production' for production mode, 'development' for debug mode
FLASK_ENV=development

# Debug mode (set to 'false' in production)
FLASK_DEBUG=true

# Secret key for session encryption (generate a new one for production!)
# Run: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your-super-secret-key-change-this-in-production

# ===========================================
# DISCORD OAUTH2 CONFIGURATION
# ===========================================

# Get these from Discord Developer Portal > Your App > OAuth2
# https://discord.com/developers/applications
DISCORD_CLIENT_ID=your-client-id-here
DISCORD_CLIENT_SECRET=your-client-secret-here

# Redirect URI (update for production domain)
DISCORD_REDIRECT_URI=http://localhost:5000/auth/callback

# Your Discord Bot Token (same as the one used by the bot)
DISCORD_BOT_TOKEN=your-bot-token-here

# ===========================================
# SERVER CONFIGURATION
# ===========================================

# Port to run the server on
PORT=5000

# ===========================================
# MUSIC BOT CONFIGURATION (LionBeatsGG)
# ===========================================

# URL of the LionBeatsGG music bot API
MUSIC_BOT_API_URL=http://127.0.0.1:3847

# ===========================================
# PRODUCTION NOTES
# ===========================================

# For production deployment:
# 1. Set FLASK_ENV=production
# 2. Set FLASK_DEBUG=false
# 3. Generate a new FLASK_SECRET_KEY
# 4. Update DISCORD_REDIRECT_URI to your domain
# 5. Use HTTPS in production
