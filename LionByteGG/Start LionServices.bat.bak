@echo off
title LionByteGG Suite - Start All Services
color 0A
cls
echo.
echo   _      _             ____        _        _____ _____
echo  ^| ^|    ^|_^|           ^|  _ \      ^| ^|      / ____/ ____^|
echo  ^| ^|     _  ___  _ __ ^| ^|_) ^|_   _^| ^|_ ___^| ^|  _^| ^|  __
echo  ^| ^|    ^| ^|/ _ \^| '_ \^|  _ ^< ^| ^| ^| __/ _ \ ^| ^|_^| ^| ^|_ ^|
echo  ^| ^|____^| ^| (_) ^| ^| ^| ^| ^|_) ^| ^|_^| ^| ^|^|  __/ ^|____^|____^|
echo  ^|______^|_^|\___/^|_^| ^|_^|____/ \__, ^|\__^\___)      ^|_____^|
echo                                __/ ^|
echo                               ^|___/
echo.
echo  ===============================================================
echo  ^|                                                             ^|
echo  ^|         LIONBYTE SUITE  -  SERVICE LAUNCHER                 ^|
echo  ^|         Starting all bots, web dashboard, + terminal        ^|
echo  ^|                                                             ^|
echo  ===============================================================
echo.

REM Navigate to workspace root (one level up from LionByteGG/)
cd /d "%~dp0.."

echo  ---------------------------------------------------------------
echo   Launching services...
echo  ---------------------------------------------------------------
echo.

echo    [1/8] Starting LionByteGG Bot...
start /min "LionByteGG Bot" cmd /k "cd /d "%~dp0" && color 0A && python main.py"
timeout /t 2 /nobreak >nul
echo           Done.
echo.

echo    [2/8] Starting LionShiftGG Bot...
start /min "LionShiftGG Bot" cmd /k "cd /d "%~dp0..\LionShiftGG" && color 0D && python main.py"
timeout /t 2 /nobreak >nul
echo           Done.
echo.

echo    [3/8] Starting BoilerCraftGG Bot...
start /min "BoilerCraftGG Bot" cmd /k "cd /d "%~dp0..\BoilerCraftGG" && color 0C && python bot.py"
timeout /t 2 /nobreak >nul
echo           Done.
echo.

echo    [4/8] Starting LionBeatsGG Lavalink...
start /min "Lavalink Server" cmd /k "cd /d "%~dp0..\LionBeatsGG\lavalink" && color 07 && java -jar Lavalink.jar"
echo           Waiting 5s for Lavalink to initialize...
timeout /t 5 /nobreak >nul
echo           Done.
echo.

echo    [5/8] Starting LionBeatsGG Bot...
start /min "LionBeatsGG Bot" cmd /k "cd /d "%~dp0..\LionBeatsGG\bot" && color 09 && node src/index.js"
timeout /t 2 /nobreak >nul
echo           Done.
echo.

echo    [6/8] Starting Web Dashboard...
start /min "LionByteGG Dashboard" cmd /k "cd /d "%~dp0web" && color 0B && python run.py"
timeout /t 2 /nobreak >nul
echo           Done.
echo.

echo    [7/8] Waiting for all services to stabilize...
timeout /t 3 /nobreak >nul
echo           Done.
echo.

echo    [8/8] Launching Master Terminal...
start "LIONBYTE Master Terminal" cmd /k "cd /d "%~dp0" && color 0E && python master_terminal.py"
timeout /t 1 /nobreak >nul
echo           Done.
echo.

echo  ===============================================================
echo  ^|                                                             ^|
echo  ^|    ALL 8 SERVICES LAUNCHED SUCCESSFULLY                     ^|
echo  ^|                                                             ^|
echo  ===============================================================
echo.
echo   Services Running:
echo     1. LionByteGG Bot          [Green]
echo     2. LionShiftGG Bot         [Purple]
echo     3. BoilerCraftGG Bot       [Red]
echo     4. LionBeatsGG Lavalink    [White]
echo     5. LionBeatsGG Bot         [Blue]
echo     6. Web Dashboard           [Cyan]
echo     7. Master Terminal          [Yellow]  (launched last)
echo.
echo   You can safely close this launcher window.
echo.
pause
