      {"path": "/api/lionshift/schedules/<index>/publish", "method": "POST", "auth": "schedules.manage"},
      {"path": "/api/lionshift/schedules/<index>/announce", "method": "POST", "auth": "schedules.manage", "does": "Manually re-announce; builds shift summary text with worker names/times/rooms"},
