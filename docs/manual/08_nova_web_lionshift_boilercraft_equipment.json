  "equipment_inventory_system": {
    "purpose": "Arena physical equipment tracking with checkout/checkin, damage/loss reports, QR-code-based self-checkout.",
    "api_routes": [
      {"path": "/api/equipment", "method": "GET", "returns": "{items, reports, active_checkouts}"},
      {"path": "/api/equipment", "method": "POST", "auth": "equipment.manage", "does": "Add new item (name, category, expected/current quantity, notes)"},
      {"path": "/api/equipment/<id>", "method": "PUT", "auth": "equipment.manage"},
      {"path": "/api/equipment/<id>", "method": "DELETE", "auth": "equipment.manage"},
      {"path": "/api/equipment/<id>/checkout", "method": "POST", "auth": "equipment.checkout", "body": "{checked_out_to, person_id, quantity(default1), id_type?, purpose?}", "does": "Decrements current_quantity"},
      {"path": "/api/equipment/<id>/checkin", "method": "POST", "auth": "equipment.checkin", "body": "{quantity(default1), condition?, checkout_id?}", "does": "Increments current_quantity"},
      {"path": "/api/equipment/<id>/report", "method": "POST", "auth": "equipment.reports", "body": "{quantity, type: missing|stolen}"},
      {"path": "/api/equipment/reports/<id>/resolve", "method": "POST", "auth": "equipment.reports", "body": "{resolution notes, recovered?}"},
      {"path": "/api/equipment/history", "method": "GET", "returns": "last 200 activity entries"},
      {"path": "/api/equipment/export", "method": "GET", "auth": "equipment.export", "returns": "CSV with Item Summary / Active Checkouts / Reports / Activity Log sections; flags missing/partial-checkout/low-stock/accounted-for status"},
      {"path": "/api/equipment/<id>/qrcode", "method": "POST", "auth": "equipment.manage", "does": "Generates a persistent QR code id for an item"},
      {"path": "/api/equipment/<id>/qrcodes", "method": "GET", "does": "Lists QR codes for one item"},
      {"path": "/api/equipment/qrcodes", "method": "GET", "does": "Lists ALL QR codes"},
      {"path": "/api/equipment/qrcode/<qr_id>", "method": "DELETE", "auth": "equipment.manage", "does": "Deactivates (does not hard-delete)"},
      {"path": "/api/equipment/qrcode/<qr_id>/image", "method": "GET", "returns": "PNG QR image encoding /onduty/equipment?checkout={item_id}&qr={qr_id}"},
      {"path": "/api/equipment/qrcode/<qr_id>/data", "method": "GET", "returns": "metadata + base64 PNG"},
      {"path": "/qr/<qr_id>", "method": "GET", "auth": "none (public)", "does": "Redirects to the checkout page, or 404 if the QR was deactivated"}
    ],
    "permission_keys": ["equipment.manage", "equipment.checkout", "equipment.checkin", "equipment.reports", "equipment.export"]
  }
