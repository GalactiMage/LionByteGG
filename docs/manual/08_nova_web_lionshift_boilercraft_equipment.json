      {"path": "/api/lionshift/worker-hours", "method": "GET", "does": "Per-worker hours from logged clock-in/out (preferred) or scheduled shifts (fallback); returns total/weekly/monthly + clocked_in status"},
      {"path": "/api/lionshift/availability", "method": "GET"},
      {"path": "/api/lionshift/availability/<worker_id>", "methods": "GET,PUT,DELETE"},
      {"path": "/api/lionshift/rooms", "method": "GET"},
      {"path": "/api/lionshift/rooms", "method": "POST", "auth": "schedules.manage", "does": "Replaces full room list; slugifies ids, validates #RRGGBB colors, 40-char name limit"},
      {"path": "/api/lionshift/shift-duties", "methods": "GET,POST", "auth_post": "schedules.manage", "shape": "duties per room per role; each task has text/show_on(start|end|both)/required"},
      {"path": "/api/lionshift/bot-settings", "methods": "GET,POST", "shape": "dm_shift_reminders, dm_late_alerts, reminder_minutes_before(5-480), late_alert_minutes(1-60), dm_new_schedule, allow_shift_trading"}
