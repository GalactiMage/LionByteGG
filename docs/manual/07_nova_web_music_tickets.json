{
  "chapter": 7,
  "title": "Nova Web Dashboard — Part 3: Music Dashboard & Ticket System",
  "path": "LionByteGG\\web\\app.py (lines ~1065-1793)",
  "music_dashboard": {
    "architecture": "Stateless proxy to the LionBeatsGG bot's REST API at http://127.0.0.1:{MUSIC_BOT_API_URL port, default 3847}. 5-second timeout per request; returns a graceful {status:'offline'} instead of erroring if the bot is unreachable.",
    "page_routes": [
      {"path": "/music/dashboard", "perm": "page.music_dashboard", "template": "music_dashboard.html"},
      {"path": "/music/nowplaying", "perm": "page.music_dashboard", "template": "music_dashboard.html (same template)"},
      {"path": "/music/settings", "perm": "page.music_dashboard", "template": "music_dashboard.html (same template)"},
      {"path": "/music/features", "perm": "page.music_features", "template": "music_features.html", "shows": "quiz songs, stats, history, panels, command reference"}
    ],
    "api_routes": [
      {"path": "/api/music/status", "method": "GET", "upstream": "GET /api/status", "does": "Adds totalListeners = sum of listenerCount across players"},
      {"path": "/api/music/top-tracks", "method": "GET", "upstream": "GET /api/stats (fallback: /api/history?limit=500 aggregated client-side)"},
      {"path": "/api/music/recent-activity", "method": "GET", "upstream": "GET /api/history?limit=20", "does": "Transforms into activity feed with relative timestamps"},
      {"path": "/api/music/command/<command>", "method": "POST", "auth": "music.player_controls", "valid_commands": ["pause", "resume", "skip", "stop"], "upstream": "finds first active player via /api/status then POST /api/player/{guildId}/{command}"},
      {"path": "/api/music/history", "method": "GET", "query": "limit(default100)", "upstream": "GET /api/history?limit=N"},
      {"path": "/api/music/history/clear", "method": "POST", "auth": "music.history", "upstream": "POST /api/history/clear"},
      {"path": "/api/music/stats", "method": "GET", "upstream": "GET /api/stats"},
      {"path": "/api/music/stats/clear", "method": "POST", "auth": "music.stats", "upstream": "POST /api/stats/clear"},
      {"path": "/api/music/quiz/songs", "methods": "GET,POST,DELETE", "auth_write": "music.quiz_manager", "upstream": "proxies to /api/quiz/songs"},
      {"path": "/api/music/panels", "method": "GET", "upstream": "GET /api/panels"},
      {"path": "/api/music/panels/<guild_id>", "method": "DELETE", "auth": "music.panels", "upstream": "DELETE /api/panels/{guild_id}"},
      {"path": "/api/music/settings", "methods": "GET,PUT", "auth_put": "music.settings", "upstream": "proxies to /api/settings"},
      {"path": "/api/music/player/<guild_id>/<action>", "method": "POST", "auth": "music.player_controls", "upstream": "POST /api/player/{guild_id}/{action}", "note": "flexible: pause/resume/skip/stop/setVolume/setShuffle etc, body passed through"},
      {"path": "/api/music/commands", "method": "GET", "upstream": "GET /api/commands"}
    ]
  },
  "ticket_dashboard": {
    "data_file": "{DATA_DIR}/ticket_log.json — {open:[...], closed:[...], blacklist:[...]}",
    "shared_with": "This same ticket_log.json is written by the LionByteGG Discord bot's ticket views (chapter 04); BoilerCraftGG has its OWN separate ticket_log.json (chapter 08).",
    "notification_bridge": "queue_discord_notification() appends to discord_notification_queue.json; the LionByteGG bot polls it and performs the actual Discord action (close channel, send message, assign staff, blacklist add/remove).",
    "ticket_object_shape": {"id": "int", "channel_name": "str", "user": "str", "user_id": "str", "type": "str", "first_name": "str", "email": "str", "explanation": "str", "status": "open|closed", "staff_assisting": "str", "created_at": "ISO", "closed_at": "ISO", "closed_by": "str", "close_reason": "str", "messages": "[]", "transcript": "[]"},
    "page_route": {"path": "/tickets", "perm": "page.tickets", "template": "tickets.html"},
    "api_routes": [
      {"path": "/api/tickets", "method": "GET", "returns": "{open,closed,blacklist,stats:{total_open,total_closed,total_created,blacklisted_users}}"},
      {"path": "/api/tickets/<id>", "method": "GET", "does": "Lookup by numeric ID or channel_name across open+closed"},
      {"path": "/api/tickets/transcripts/<id>", "method": "GET", "does": "Searches closed first then open, returns messages+transcript"},
      {"path": "/api/tickets/<id>/close", "method": "POST", "auth": "tickets.close", "body": "{reason}", "does": "Moves open->closed, sets closed_at/closed_by/close_reason, queues 'close_ticket' notification"},
      {"path": "/api/tickets/blacklist/add", "method": "POST", "auth": "tickets.blacklist", "body": "{user_id,reason}", "does": "Prevents duplicate; queues 'ticket_blacklist_add'"},
      {"path": "/api/tickets/blacklist/remove", "method": "POST", "auth": "tickets.blacklist", "body": "{user_id}", "does": "Queues 'ticket_blacklist_remove'"},
      {"path": "/api/tickets/closed/<id>/delete", "method": "DELETE", "auth": "tickets.delete_closed"},
      {"path": "/api/tickets/closed/delete-all", "method": "DELETE", "auth": "tickets.delete_closed", "returns": "{deleted_count}"},
      {"path": "/api/tickets/<id>/message", "method": "POST", "auth": "tickets.send_message", "body": "{message,mention_user,index}", "does": "Queues 'ticket_message' — dashboard does not write the transcript directly, the bot manages messages"},
      {"path": "/api/tickets/<id>/assign", "method": "POST", "auth": "tickets.assign", "body": "{index}", "does": "Sets staff_assisting to current session user, queues 'ticket_assign'"}
    ]
  },
  "discord_notification_queue_mechanism": {
    "file": "{DATA_DIR}/discord_notification_queue.json",
    "entry_shape": {"type": "close_ticket|ticket_message|ticket_assign|ticket_blacklist_add|ticket_blacklist_remove|...", "status": "pending|processing|completed|failed", "queued_at": "ISO", "...type_specific_fields": "..."},
    "flow": ["Dashboard modifies ticket_log.json then calls queue_discord_notification()", "LionByteGG bot's process_discord_notifications loop (10s) polls this file", "Bot performs the Discord action, sets status completed/failed"]
  },
  "permission_keys": ["music.player_controls", "music.history", "music.stats", "music.quiz_manager", "music.panels", "music.settings", "tickets.close", "tickets.blacklist", "tickets.delete_closed", "tickets.send_message", "tickets.assign"]
}
